.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ─────────────────────────────────────────────────────────────
# Project data — DO NOT commit large binaries
# ─────────────────────────────────────────────────────────────
# Weights: distributed via download_weights.sh, not git
data/weights/*
!data/weights/.gitkeep

# Calibration images: user-provided, not committed
data/calib/*
!data/calib/.gitkeep

# Eval images: user-provided, not committed
data/eval/*
!data/eval/.gitkeep

# Compiled artifacts (xmodels, intermediate quantization, etc.)
out/
build/
*.xmodel
*.h5
*.onnx
*.pth
*.pt
!data/weights/.gitkeep

# DPU bitstream files (downloaded by Kria setup script, not committed)
*.bit
*.hwh
*.xclbin

# ─────────────────────────────────────────────────────────────
# Logs
# ─────────────────────────────────────────────────────────────
*.log
logs/

# ─────────────────────────────────────────────────────────────
# OS / package manager
# ─────────────────────────────────────────────────────────────
*.tar
*.tar.gz
*.tar.xz
*.zip
*.deb
*.img
*.img.xz

# Allow specific zips if explicitly tracked
!docs/assets/*.zip


# Benchmark artifacts (auto-downloaded, not source code)
notebooks/Models_VAI35/
notebooks/Datasets/
notebooks/vai35_*.csv
notebooks/vai35_*.md
notebooks/vai35_smoke_test.csv

# Also worth excluding (your existing 2.5 benchmark, if present)
notebooks/Models/
notebooks/Dataset/
notebooks/full_benchmark_results.csv
notebooks/benchmark_report.md
notebooks/coco_map_results.csv
# ─────────────────────────────────────────────────────────────
# v0.10: hard-neg work
# ─────────────────────────────────────────────────────────────
# New calib subdirs (large image sets, regeneratable from source datasets)
data/calib_lpr_backup/
data/calib_v2_hardneg/
data/calib_v3_*/
data/calib_v4_*/

# v0.10: allow .pt weight files (override earlier data/weights/* rule)
!data/weights/*.pt

# Editor / patch backups (created by manual rollback workflows)
*.bak
*.backup
*~

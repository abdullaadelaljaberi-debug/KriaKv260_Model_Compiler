*$py.class
*.so
.Python
*.egg-info/
*.egg
build/
dist/
.eggs/
develop-eggs/
.installed.cfg
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
.env
.venv
venv/
env/
ENV/

